make_editing_condition<-function(editing_type_in,tsv_name){
  #editing_type_in<-editing_ag_condition
  editing_condition<-editing_type_in%>% dplyr::select(-c("Editing_Index","Mean"))#,"ESid"))
  editing_condition<-as.data.frame(t(editing_condition))
  colnames(editing_condition) <- editing_condition[1, ]
  editing_condition <- editing_condition[-1, ]
  editing_condition<-editing_condition %>%
    mutate_all(as.numeric)
  editing_condition<-editing_condition%>%rownames_to_column("Sample")
  
  micro_meta<-micro_meta%>%dplyr::select(c(Sample,Stimulation))
  editing_condition<-merge(micro_meta, editing_condition, by="Sample")
  
  #editing_condition$Stimulation <- str_split_fixed(editing_condition$Sample, "-", 3)[,3]
  #editing_condition<-editing_condition%>%dplyr::select(-c("Sample"))
  #editing_condition$Mean <- rowMeans(editing_condition[, -which(names(editing_condition) == "Stimulation|Sample")])
  editing_condition$Mean <- rowMeans(editing_condition[, !(names(editing_condition) %in% c("Stimulation", "Sample"))])
  #editing_condition$Stimulation<-gsub("B","Basal",editing_condition$Stimulation)
  #editing_condition$Sample <- str_trim(str_split_fixed(editing_condition$Sample, "-", 3)[,3])

  #editing_condition$Sample <-  sub("-(B|LPS|IFNg)$", "", editing_condition$Sample)
  #editing_condition<-editing_condition%>%dplyr::select(c(Sample,Stimulation, Mean, everything(.)))
  editing_condition<-editing_condition%>%dplyr::select(c(Sample,Stimulation, Mean, everything(.)))
  #editing_condition<-as.data.frame(t(editing_condition))
  write_tsv(editing_condition,"Alternation/Jacusa/Processed_AG_Editing.tsv")
}

