des_count<-function(des_in){
  ag_des<-des_in%>%dplyr::filter(grepl("A:G_DE",DE_Index))
  ag_des_up<-ag_des%>%dplyr::filter(logFC>0)
  ag_des_down<-ag_des%>%dplyr::filter(logFC<0)
  
  print(paste0("A:G DES UP: ",nrow(ag_des_up)," A:G DES DOWN: ",nrow(ag_des_down)))
  
  ct_des<-des_in%>%dplyr::filter(grepl("C:T_DE",DE_Index))
  ct_des_up<-ct_des%>%dplyr::filter(logFC>0)
  ct_des_down<-ct_des%>%dplyr::filter(logFC<0)
  
  print(paste0("C:T DES UP: ",nrow(ct_des_up)," C:T DES DOWN: ",nrow(ct_des_down)))
}

deg_count<-function(deg_in){
  deg_up<-deg_in%>%dplyr::filter(grepl("UP",DE_Direction))
  deg_down<-deg_in%>%dplyr::filter(grepl("DOWN",DE_Direction))
  
  print(paste0("DEG UP: ",nrow(deg_up)," DEG DOWN: ",nrow(deg_down)))
}

