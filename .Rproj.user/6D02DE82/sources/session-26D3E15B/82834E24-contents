editing_type<-read_tsv("/Users/hyominseo/Desktop/RAJ_RNA_Editing/Replication/Jacusa/Processed_Editing_Type.tsv")
colnames(editing_type)<-gsub("-B","-Basal", colnames(editing_type))
editing_ag_condition<-editing_type%>%dplyr::filter(grepl("A:G", Editing_Index))
editing_ct_condition<-editing_type%>%dplyr::filter(grepl("C:T", Editing_Index))

make_editing_condition<-function(editing_type_in,tsv_name){
  editing_condition<-editing_type_in%>% dplyr::select(-c("Editing_Index","Mean","ESid"))
  editing_condition<-as.data.frame(t(editing_condition))
  editing_condition<-editing_condition%>%rownames_to_column("Sample")
  editing_condition$Stimulation <- str_split_fixed(editing_condition$Sample, "-", 3)[,3]
  editing_condition<-editing_condition%>%dplyr::select(-c("Sample"))
  editing_condition$Mean <- rowMeans(editing_condition[, -which(names(editing_condition) == "Stimulation")])
  editing_condition<-editing_condition%>%dplyr::select(c(Stimulation, Mean, everything(.)))
  write_tsv(editing_condition,tsv_name)
}

editing_ag_condition<-make_editing_condition(editing_ag_condition,"/Users/hyominseo/Desktop/RAJ_RNA_Editing/Replication/Jacusa/Processed_AG_Editing.tsv")
editing_ct_condition<-make_editing_condition(editing_ct_condition,"/Users/hyominseo/Desktop/RAJ_RNA_Editing/Replication/Jacusa/Processed_CT_Editing.tsv")
