```{r path_1, echo= FALSE, message = FALSE, warning=FALSE, eval=FALSE}
run_gprofiler<-function(cohort_in,gp_title){
  if (cohort_in == "LPS"){diff_in<-read_tsv("TopTable/Editing_Differential/LPS_1_Toptable.tsv")}
  if (cohort_in == "IFNg"){diff_in<-read_tsv("TopTable/Editing_Differential/IFNg_1_Toptable.tsv")}
  
  gene_name_all<-diff_in[['Gene']]
  gene_name_up<-diff_in%>%dplyr::filter(logFC >0)
  gene_name_down<-diff_in%>%dplyr::filter(logFC <0)
  #gene_name_down<-gene_name_down%>%dplyr::select("Gene")
  #write_tsv(gene_name_down,"Pathway/Python/Gene_Name/IFNg_1_DOWN_Name.tsv")
 
  multi_gp<- gost(list("up-regulated" = gene_name_up$Gene,
                       organism = "hsapiens",domain_scope = "custom",
                       custom_bg=gene_name_all,
                       "down-regulated" = gene_name_down$Gene,
                       organism = "hsapiens",domain_scope = "custom",
                       custom_bg=gene_name_all))

  message("Writing gost tsv")
  multi_gp<-multi_gp$result%>%arrange(desc(precision))
  multi_gp<-multi_gp%>%dplyr::filter(grepl("GO:BP|KEGG",source))
  multi_gp$log_P_value<-(-log(multi_gp$p_value))
  multi_gp<-multi_gp%>%
    dplyr::select(c("significant","p_value","precision","term_id","source","term_name","log_P_value"))
  filepath<-"/Users/hyominseo/Desktop/RAJ_Microglia/Pathway/"
  write_tsv(multi_gp, file =file.path(filepath,gp_title))
}

run_gprofiler("LPS","LPS_DES_GP.tsv")
run_gprofiler("IFNg",""IFNg_DES_GP.tsv")
