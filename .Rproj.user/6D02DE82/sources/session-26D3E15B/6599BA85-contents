```{r data_3, echo= TRUE, message = FALSE, eval=FALSE}
tpm<-read_tsv("Metadata/Gene_Expression/Processed_Normalized_TPM.tsv")
names(tpm) <- gsub(x = names(tpm), pattern = "\\.", replacement = "-")

gencode<-read_tsv("RData/gencode.v30.tx2gene.tsv")

a_genes<-gencode%>%dplyr::filter(grepl("ADAR|APOBEC",GENENAME))%>%
  distinct(GENENAME, .keep_all=TRUE)%>%
  dplyr::select(-c(TXNAME))
tpm<-tpm%>%dplyr::filter(GENEID %in% a_genes$GENEID)
tpm<-merge(tpm, a_genes, by="GENEID")

adar_tpm<-tpm%>%dplyr::filter(grepl("ADAR",GENENAME))%>%
  dplyr::select(GENENAME, GENEID, everything(.))
adar_tpm<-adar_tpm%>%pivot_longer(where(is.numeric), names_to="Sample" , values_to = "Norm_TPM")

adar_tpm[c('chr','num','Stimulation')]<-str_split_fixed(adar_tpm$Sample, "-",3)
adar_tpm<-adar_tpm%>%dplyr::select(-c(chr,num))

apob_tpm<-tpm%>%dplyr::filter(grepl("APOBEC",GENENAME))%>%
  dplyr::select(GENENAME, GENEID, everything(.))
apob_tpm<-apob_tpm%>%pivot_longer(where(is.numeric), names_to="Sample" , values_to = "Norm_TPM")

apob_tpm[c('chr','num','Stimulation')]<-str_split_fixed(apob_tpm$Sample, "-",3)
apob_tpm<-apob_tpm%>%dplyr::select(-c(chr,num))

filepath<-file.path("/Users/hyominseo/Desktop/RAJ_RNA_Editing/Discovery/RData")
save(adar_tpm,apob_tpm,file= file.path(filepath,"165_Stim_A_Genes_TPM.RData"))

a_genes_meta<-rbind(adar_tpm,apob_tpm)
a_genes_meta<-a_genes_meta%>%dplyr::select(c(GENENAME, Sample, Norm_TPM))
a_genes_meta<-a_genes_meta%>%pivot_wider(names_from = GENENAME, values_from =Norm_TPM)
meta_all<-merge(meta, a_genes_meta, by ="Sample")
write_tsv(meta_all, "Metadata/165_Monocytes_Metadata_All.tsv")
