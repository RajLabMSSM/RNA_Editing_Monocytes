perform_dream<-function(count_in, form_in, meta_in ){
  message("voom")
  vobjDream = suppressWarnings( voomWithDreamWeights( count_in, form_in, meta_in))
  message("dream")
  fitmm = suppressWarnings (dream( vobjDream, form_in, meta_in ))

  message("linear")
  fitmm_ebayes <- eBayes(fitmm)
  fitmm_ebayes
}

