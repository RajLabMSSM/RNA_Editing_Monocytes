qc_plot<-function(df_in, x_in,Diagnosis, y_in){#},plot_title){
  qc_plot<-ggplot(data=df_in,aes(x=x_in, y=y_in))+
    geom_jitter(aes(colour=Cohort), alpha =0.6, width= 0.25, size = point_size)+
