# Gene Expression Processing
```{r stim_1, echo= TRUE, message = FALSE, warning=FALSE, eval=TRUE}
prep_counts<-function(counts_in,meta_in ){
  counts_in<-counts_in[!duplicated(counts_in),]
  counts_in<-counts_in[colnames(counts_in) %in% meta_in$Sample]
  counts_in<-counts_in%>%rownames_to_column("GENEID")
  counts_in
}

tpm_threshold<-1
#meta_in<-meta

prep_tpm<-function(tpm_in,meta_in){
  #tpm_in<-genes_tpm
  #tpm_in<-tpm_in[!duplicated(tpm_in),]
  tpm_in<-tpm_in[colnames(tpm_in) %in% meta_in$Sample]
  tpm_in<-tpm_in%>%dplyr::filter(rowMeans(.)>tpm_threshold)#%>%
  tpm_in<-tpm_in%>%dplyr::mutate(SD=rowSds(as.matrix(.),useNames=TRUE))%>%
    dplyr::filter(SD > 0) %>%
    dplyr::select(.,-SD)
  tpm_in<-tpm_in%>%rownames_to_column("GENEID")
  tpm_in
}

