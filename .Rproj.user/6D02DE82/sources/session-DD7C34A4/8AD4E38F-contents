```{r stim_9,echo= TRUE, message = FALSE,warning=FALSE, eval=TRUE}
pca<-function(tpm_in){
  tpm_in<-as.data.frame(t(tpm_in))
  tpm_in<-mutate_all(tpm_in, function(x) as.numeric(as.character(x)))
  tpm_in<-prcomp(tpm_in, scale.=TRUE, center=TRUE)
  tpm_in<-tpm_in$x[,1:10]
  tpm_in<-tibble::rownames_to_column(as.data.frame(tpm_in),'Sample')
  tpm_in
}

pca_12<-function(meta_in, pca_in){
  
  meta<-meta_in%>%column_to_rownames("Sample")
  pca_12<-pca_in%>%column_to_rownames("Sample")%>%dplyr::select("PC1","PC2")
  pca_12<-merge(meta, pca_12, by =0)%>%
    column_to_rownames("Row.names")
  pca_12
}

pca_plot <- function(pca_in, col_name,plot_title) {
  ggplot(pca_in, aes(x = PC1, y = PC2, color = .data[[col_name]])) +
    geom_point(alpha = 0.9, size = point_size) +
    labs(color = col_name, title = plot_title) +
    theme(
      plot.title = element_text(size = title_size, face = 'bold', hjust = 0.5),
      axis.text = element_text(size = axis_size),
      axis.title = element_text(size = axis_size),
      text = element_text(size = text_size)
    ) +
    guides(color = guide_legend(override.aes = list(size=legend_size)))+
    theme_classic()
}

pca_plots <- function(pca_in, col_names,plot_title) {
  plots <- lapply(col_names, function(col_name) {
    pca_plot(pca_in, col_name,plot_title)
  })
  return(plots)
}

