# HEATMAP : MiGA All
```{r pca_1, echo= TRUE, message = FALSE, warning=FALSE, eval=TRUE}
load("/Users/hyominseo/Desktop/MiGA_Bulk/new_Metadata/MiGA_All/MiGA_ALL_TPM_Norm_PCA_PCA12.RData")
meta_all<-read_tsv("new_Metadata/MiGA_All/Final_MiGA_ALL_Meta.tsv")

meta_select<-meta_all%>%dplyr::select(-c("Donor_ID","Sample",
                                         "RIBOSOMAL_BASES","CODING_BASES",
                                         "UTR_BASES","INTRONIC_BASES",
                                         "INTERGENIC_BASES","IGNORED_READS",
                                         "CORRECT_STRAND_READS","INCORRECT_STRAND_READS"))

meta_select$APOE <- ifelse(is.na(meta_select$APOE), "Unknown",meta_select$APOE)
meta_select$Cause_of_Death <- ifelse(is.na(meta_select$Cause_of_Death), "Unknown",meta_select$Cause_of_Death)

covariates<-colnames(meta_select)
n_var <- length(covariates)

indx<-sapply(meta_select, is.character)
# assigning factors instead of categorical name values
meta_select[indx]<-lapply(meta_select[indx],function(x) as.factor(x))

matrix_rsquared <- matrix(NA, nrow = n_var, ncol = 5) 
matrix_pvalue <- matrix(NA, nrow = n_var, ncol = 5) 

pc_matrix<-function(pca_in, meta_in){
  index_pca<-pca_in%>%tibble::column_to_rownames("Sample")
  index_index_pca<-index_pca[,1:5]
  for (x in 1:n_var){
    for(y in 1:5){
      matrix_rsquared[x,y]<-summary(lm(unlist(index_index_pca[,y])~
                                         as.matrix(meta_select[,covariates[x]])))$adj.r.squared}
    }
  matrix_rsquared
  }

pc_heatmap<-function(pca_in, meta_in,plot_title ){
  index_pca<-pca_in%>%tibble::column_to_rownames("Sample")
  index_pca<-index_pca[,1:5]
  
  index_pc_matrix<-pc_matrix(pca_in, meta_in)
  
  rownames(index_pc_matrix)<-covariates
  colnames(index_pc_matrix)<-colnames(index_pca)
  range<-max(abs(index_pc_matrix))
  
  pc_heatmap<-pheatmap(index_pc_matrix,main = plot_title,
                       labels_col = colnames(index_pc_matrix),
                       display_numbers = TRUE, breaks = seq(-range, range,length.out =100),
                       fontsize = 8, color = hcl.colors(100,"PRGn"), cluster_rows=F,
                       cluster_cols=F, legend=FALSE)
  pc_heatmap
}

miga_all_heatmap<-pc_heatmap(tpm_pca,meta_select,"MiGA All PCA")
miga_all_heatmap<-as.ggplot(miga_all_heatmap, scale=1)
miga_all_heatmap
```


