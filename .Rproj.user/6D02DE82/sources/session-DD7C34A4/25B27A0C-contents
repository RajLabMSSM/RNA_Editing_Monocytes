# MiGA All = MiGA 1 + 2 + 3
* from multiple brain region from different cohort
* all COVID related terms associated with each donor (sample) were tested for PCA to see that COVID did not act as a grouping factor, therefore was removed from all diagnosis terms. 



```{r, echo= FALSE, message = FALSE, warning=FALSE, eval=TRUE}
meta_all<-read_tsv("new_Metadata/MiGA_All/Final_MiGA_ALL_Meta.tsv")
meta_all$APOE <- ifelse(is.na(meta_all$APOE), "Unknown", meta_all$APOE)
meta_all$Cause_of_Death <- ifelse(is.na(meta_all$Cause_of_Death), "Unknown", meta_all$Cause_of_Death)

meta_donor<-meta_all%>%distinct(Donor_ID, .keep_all=TRUE)

meta_1<-meta_all%>%dplyr::filter(grepl("MiGA_1",Cohort))
meta_2<-meta_all%>%dplyr::filter(grepl("MiGA_2",Cohort))
meta_3<-meta_all%>%dplyr::filter(grepl("MiGA_3",Cohort))

meta_long<-meta_all[,grepl("Cohort|Sample|PCT|PF|Sex|MEDIAN_5PRIME_BIAS",colnames(meta_all))]
meta_long<-meta_long%>%dplyr::select(-c("PCT_USABLE_BASES"))

meta_long<-meta_long%>%
  pivot_longer(where(is.numeric),names_to="metric", values_to="Value")
```


