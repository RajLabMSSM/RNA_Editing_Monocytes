    geom_jitter(aes(colour = Diagnosis), alpha = 0.7, width = 0.25, size = point_size) +
    #geom_jitter(aes(colour = Sample_Cohort,shape=shape_in), alpha = 0.7, width = 0.25, size = point_size) +
    #scale_color_manual(values = cohort_color) +
