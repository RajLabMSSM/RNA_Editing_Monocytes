## Diff: Region Crosscheck {.tabset .tabset-fade .tabset-pills}
```{r region_cross_1, echo= TRUE, message = FALSE, warning=FALSE, eval=TRUE}

form_sn_de<-read_tsv("Differential/Final_Toptable/Region_Specific/SN_form_toptable.tsv", show_col_types = FALSE)
form_fr_de<-read_tsv("Differential/Final_Toptable/Region_Specific/FR_form_toptable.tsv", show_col_types = FALSE)
form_occ_de<-read_tsv("Differential/Final_Toptable/Region_Specific/OCC_form_toptable.tsv", show_col_types = FALSE)


compare_direction_genes <- function(direction_in, df_1_name, df_2_name, df_3_name) {
  # Get UP genes from each dataframe
  df1<-form_sn_de
  df2<-form_fr_de
  df3<-form_occ_de
  
  df1<-df1%>%dplyr::select(-c(DE_genes_5, DE_genes_10,DE_Direction_5, DE_Direction_10))
  df1 <-df1 %>%
  mutate(Direction = case_when(
    logFC >= 0 ~ "UP",
    logFC < 0 ~ "DOWN"
  ))
  
  df2<-df2%>%dplyr::select(-c(DE_genes_5, DE_genes_10,DE_Direction_5, DE_Direction_10))
  df2 <-df2 %>%
  mutate(Direction = case_when(
    logFC >= 0 ~ "UP",
    logFC < 0 ~ "DOWN"
  ))
  
  df3<-df3%>%dplyr::select(-c(DE_genes_5, DE_genes_10,DE_Direction_5, DE_Direction_10))
  df3 <-df3 %>%
  mutate(Direction = case_when(
    logFC >= 0 ~ "UP",
    logFC < 0 ~ "DOWN"
  ))
  
  genes_df1 <- df1[df1$Direction == direction_in, "GENENAME"]
  genes_df2 <- df2[df2$Direction == direction_in, "GENENAME"]
  genes_df3 <- df3[df3$Direction == direction_in, "GENENAME"]
  print(paste0("SN ", direction_in,  "_genes: ",  (length(unique(genes_df1$GENENAME)))))
  print(paste0("FR ", direction_in,  "_genes: ",   (length(unique(genes_df2$GENENAME)))))
  print(paste0("OCC ", direction_in,  "_genes: ",   (length(unique(genes_df3$GENENAME)))))
  
  print(paste0("SN_FR Common ", direction_in,  "_genes: ",
         length(unique(intersect(genes_df1$GENENAME,genes_df2$GENENAME)))))
  print(paste0("SN_OCC Common ", direction_in,  "_genes: ",
         length(unique(intersect(genes_df1$GENENAME,genes_df3$GENENAME)))))
  print(paste0("FR_OCC Common", direction_in,  "_genes: ",
         length(unique(intersect(genes_df2$GENENAME,genes_df3$GENENAME)))))
  
  common_12 <- data.frame(intersect(genes_df1$GENENAME, genes_df2$GENENAME)) 
  common_12 <-common_12%>% dplyr::rename('SN_FR' = 'intersect.genes_df1.GENENAME..genes_df2.GENENAME.')
  
  common_13<-data.frame(intersect(genes_df1$GENENAME,genes_df3$GENENAME))
  common_13 <-common_13%>% dplyr::rename('SN_OCC' ='intersect.genes_df1.GENENAME..genes_df3.GENENAME.')
  
  common_23<-data.frame(intersect(genes_df2$GENENAME,genes_df3$GENENAME))
  common_23 <-common_23%>% dplyr::rename('FR_OCC' ='intersect.genes_df2.GENENAME..genes_df3.GENENAME.')
  
  
  common_12_3<-data.frame(intersect(common_12$SN_FR, genes_df3$GENENAME))
  # all other combination is the same
  common_12_3<-common_12_3%>%dplyr::rename('SN_FR_OCC' = 'intersect.common_12.SN_FR..genes_df3.GENENAME.')
  print(paste0("SN_FR_OCC Common ", direction_in,  "_genes: ", (length(unique(common_12_3$SN_FR_OCC)))))
  
  df1_common<-df1%>%dplyr::filter(GENENAME %in% common_12_3$SN_FR_OCC)
  write_tsv(df1_common,df_1_name)
  df2_common<-df2%>%dplyr::filter(GENENAME %in% common_12_3$SN_FR_OCC)
  write_tsv(df2_common,df_2_name)
  df3_common<- df3%>%dplyr::filter(GENENAME %in% common_12_3$SN_FR_OCC)
  write_tsv(df3_common,df_3_name)
}

