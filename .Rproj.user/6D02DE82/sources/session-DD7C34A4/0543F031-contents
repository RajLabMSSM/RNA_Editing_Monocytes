select_gene<-function(df,gene_in){
  df<-df%>%rownames_to_column("GENENAME")
  df<-df%>%dplyr::filter(grepl(gene_in,GENENAME))
  df<-df%>%dplyr::select(GENENAME, everything())
  df<-df%>%
    pivot_longer(where(is.numeric), names_to = "Sample", values_to = "Norm_TPM")
  df<-merge(df, meta, by ="Sample")
  df
}

select_gene_pro<-function(df,gene_in){
  df<-df%>%rownames_to_column("GENENAME")
  df<-df%>%dplyr::filter(grepl(gene_in,GENENAME))
  df<-df%>%dplyr::select(GENENAME, everything())
  df<-df%>%
    pivot_longer(where(is.numeric), names_to = "Sample", values_to = "Norm_Protein")
  df<-merge(df, meta, by ="Sample")
  df
}

