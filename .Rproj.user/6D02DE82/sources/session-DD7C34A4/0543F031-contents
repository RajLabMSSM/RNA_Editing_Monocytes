pro_make_DE_genes<-function(linear_in,file_name ){
  message("Generating Toptable")
  DE_genes<-topTable(linear_in, sort.by = "p",n=Inf, coef = 3)
  DE_genes$GENEID<-rownames(DE_genes)  

  # nth is 3rd for PD
  #linear_in<-pro_dream_fit
 #print(summary(decideTests(grouped_pro_dream_fit,adjust.method = "BH", p.value  = "0.05")))
  message("Adding Selective Cols")
  DE_genes$DE_genes_5<-case_when(
  DE_genes$adj.P.Val < 0.05  ~ "TRUE", 
    .default = "FALSE"
    )
  
  DE_genes$DE_Direction_5 <- case_when(
    DE_genes$DE_genes_5 == "TRUE" & DE_genes$logFC > 0.00 ~ "UP",
    DE_genes$DE_genes_5 == "TRUE" & DE_genes$logFC < 0.00 ~ "DOWN",
    DE_genes$DE_genes_5 == "FALSE" ~ "FALSE"
  )
  write_tsv(DE_genes, file_name)
}


make_pro_plots<-function( res_in , plot_title, plot_name){
  res <-read_tsv(res_in)
  p<- ggplot(res, aes(P.Value))
  fdr_plot<- p + geom_density(color="darkblue", fill="lightblue") +
    theme_classic() +
    ggtitle("FDR Distribution")
  
  #plot.data <- form_1_de
  plot.data<-read_tsv(res_in)
  plot.data$id <- rownames(plot.data)
  data <- data.frame(plot.data)
  data$P.Value <- (-log10(data$P.Value))
  data$FDR_5 <- as.factor(abs(data$adj.P.Val < 0.05))
  data$FDR_10 <- as.factor(abs(data$adj.P.Val < 0.10))
  data_select<-data%>%dplyr::filter(abs(logFC)>2)
  data_select<-data_select%>%dplyr::filter(adj.P.Val<0.1)
  
  ma <- ggplot(data, aes(AveExpr, logFC, color = FDR_5))
  ma_plot<-ma + geom_point() +
    scale_color_manual(values = c("#dbdbdb", "#eb8931"), labels = c ("> 0.05", "< 0.05")) +
    labs(title = "MA plot", color = "FDR") +
    theme_classic()
  
  vp_5<- ggplot(data, aes(logFC, P.Value, color = FDR_5))
  vp_plot_5<-vp_5 + geom_point() +
    scale_color_manual(values = c("#dbdbdb", "#eb8931"), labels = c("> 0.05", "< 0.05")) + 
    labs(title = "Gene Level Volcano Plot: FDR 5", color = "FDR") +
    theme_classic()+
    geom_label_repel(data = data_select, aes(label =GENEID), 
                     box.padding   = 0, point.padding = 0, force = 100,
                     segment.size  = 0.3,segment.color = "black",
                     angle = 180,point.size = point_size,color="black",
                     nudge_x = 0.5,hjust =0,size = point_size)
  
  vp_10<- ggplot(data, aes(logFC, P.Value, color = FDR_10))
  vp_plot_10<-vp_10 + geom_point() +
    scale_color_manual(values = c("#dbdbdb", "#eb8931"), labels = c("> 0.1", "< 0.1")) + 
    labs(title = "Gene Level Volcano Plot: FDR 10", color = "FDR") +
    theme_classic()+
    geom_label_repel(data = data_select, aes(label =GENEID), 
                     box.padding   = 0, point.padding = 0, force = 100,
                     segment.size  = 0.3,segment.color = "black",
                     angle = 180,point.size = point_size,color="black",
                     nudge_x = 0.5,hjust =0,size = point_size)
  
  plots<-ggarrange(fdr_plot, ma_plot, vp_plot_5, vp_plot_10,ncol=2,nrow=2)
  plots<-annotate_figure(plots,top=text_grob(plot_title,
                                         color = "black",face="bold", size =14))
  ggsave(plot=plots,filename=plot_name,width = 12, height = 8,dpi = 600)
}


