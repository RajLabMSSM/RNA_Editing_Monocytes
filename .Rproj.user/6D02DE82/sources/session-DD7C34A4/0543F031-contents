```{r diff_region_2, echo= TRUE, message = FALSE, warning=FALSE, eval=FALSE}

perform_diff<-function(count_in, form_in, meta_in ){
  message("norm")
  count_in_norm<-calcNormFactors(count_in, method="TMM")
  dge<-DGEList(counts=count_in, samples = meta_in, norm.factors= count_in_norm)
  message("voom")
  v <- voom(dge, design= form_in)
  vfit<-lmFit(v,form_in)
  efit<-eBayes(vfit)
  efit
}

region_make_DE_genes<-function(linear_in,file_name ){
  message("Generating Toptable")
  DE_genes<-topTable(linear_in, sort.by = "p",n=Inf, coef = 2)
  DE_genes$GENEID<-rownames(DE_genes)  

  #print(summary(decideTests(linear_in,adjust.method = "BH", p.value  = "0.05")))
  # intercept as 1, and n th variable must bt eh target coef unmber 
  message("Adding Selective Cols")
  DE_genes$DE_genes_5<-case_when(
  DE_genes$adj.P.Val < 0.05  ~ "TRUE", 
    .default = "FALSE"
    )
  
  DE_genes$DE_Direction_5 <- case_when(
    DE_genes$DE_genes_5 == "TRUE" & DE_genes$logFC > 0.00 ~ "UP",
    DE_genes$DE_genes_5 == "TRUE" & DE_genes$logFC < 0.00 ~ "DOWN",
    DE_genes$DE_genes_5 == "FALSE" ~ "FALSE"
  )
  
  DE_genes$DE_genes_10<-case_when(
  DE_genes$adj.P.Val < 0.1  ~ "TRUE", 
    .default = "FALSE"
    )
  
  DE_genes$DE_Direction_10 <- case_when(
    DE_genes$DE_genes_10 == "TRUE" & DE_genes$logFC > 0.00 ~ "UP",
    DE_genes$DE_genes_10 == "TRUE" & DE_genes$logFC < 0.00 ~ "DOWN",
    DE_genes$DE_genes_10 == "FALSE" ~ "FALSE"
  )

  DE_genes<-merge(DE_genes,gencode, by = "GENEID")
  
  DE_genes<-DE_genes%>%distinct(GENEID, .keep_all=TRUE)
  write_tsv(DE_genes, file_name)
}
