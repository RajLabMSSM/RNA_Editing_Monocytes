  heatmap<-ComplexHeatmap::Heatmap(as.matrix(df_res_0.01), 
                        name = "DE FDR<1%",
                        cell_fun = function(j, i, x, y, width, height, fill) {
                            grid.text(sprintf("%d", df_res_0.01[i, j]), x, y, gp = gpar(fontsize = 10))}, 
                        cluster_columns = F, 
                        cluster_rows = F, 
                        col = colorRamp2(c(min(df_res_0.01,na.rm = T),
                                           max(df_res_0.01,na.rm = T)), 
                                         c("white", "#CB454A")), 
                        rect_gp = gpar(col = "white", lwd = 2) )
  heatmap
}

