inplot_size = 3
text_size= 10
title_size = 10
point_size =3
axis_size =9
legend_size=9

eigen_plot<-function(df_in, Diagnosis, y_in,y_title, plot_title){
  wilcox_test<-wilcox.test(Eigengene ~ Diagnosis,  data=df_in)
  p_value <- wilcox_test$p.value
  
  qc_plot<-ggplot(data=df_in,aes(x=Diagnosis, y=y_in, fill =Diagnosis))+
    geom_jitter(aes(colour=Diagnosis), alpha =0.6, width= 0.25, size = point_size)+
    geom_boxplot(fill=NA,outlier.shape=NA)+stat_compare_means(label = "p.signif",
                                                              label.x =1.5,label.y =0.1)+
    labs(
      title = paste(
        plot_title,
        "\nWilcoxon P.val =", format(p_value, digits = 4)
      ),
      x = "Diagnosis",
      y = y_title)+theme_classic()+
    theme(legend.title = element_text(size=text_size),
          legend.text = element_text(size=text_size),
          axis.text.x = element_text(size = axis_size),
          axis.text.y = element_text(size = axis_size),
          axis.title = element_text(size = axis_size),
          plot.title = element_text(size=title_size, hjust=0.5),
          legend.margin=margin(0,0,0,0),
          legend.box.margin=margin(-5,-5,-5,-5))+
    theme(legend.position = "none")+
    guides(color = guide_legend(override.aes = list(size=legend_size)))
  qc_plot
}




heatmap<-function(cov.df, df, print=T, return.PC=T, boxplot=T,
                  heatmap_title='BOX1', 
                  title_box='INPUT_BBY', fs1=8, fs2=5){
  
  # gs<-read.xlsx("/Users/hyominseo/Desktop/MiGA_Bulk/Proteomics/Gene_set/Gene_subset_phago/GTPases_Phago_3.xlsx")
  # df<-mg_tpm_select_norm
  # df <- df[rownames(df) %in% toupper(gs[,1]),]
  # cov.df<-mg_meta_select
  # number of genes in the in put count df (12 genes from ANTI class 2 )
  num_pcs<-nrow(df)
  ``
  # num_pc = gene count, length(colnames(df) = sample count)
  l <- min(num_pcs,length(colnames(df)))
  covariates <- colnames(cov.df)
  # df col = sample, df row = genes
  pca.cov <- prcomp(df,center = T, scale. = T)
  var <- get_pca_var(pca.cov) # description of PCs
  ind <- get_pca_ind(pca.cov) # PCs for individuals
  matrix_rsquared = matrix(NA, nrow = length(cov.df), ncol = l) #Number of factors
  matrix_pvalue = matrix(NA, nrow = length(cov.df), ncol = l)
  
  for (x in 1:length(covariates)){
    for (y in 1:l){
      matrix_rsquared[x,y] <- summary( lm(var$cor[,y] ~ cov.df[,covariates[x]]) )$adj.r.squared
      matrix_pvalue[x,y] <- glance( lm(var$cor[,y] ~ cov.df[,covariates[x]]) )$p.value #To insert pvalues in the heatmap
    }
  }
  
  rownames(matrix_rsquared) = covariates
  rownames(matrix_pvalue) = covariates 
  colnames(matrix_rsquared) = paste("PC",1:l, sep="")
  
  matrix_pvalue = matrix(p.adjust(as.vector(as.matrix(matrix_pvalue)),
                                  method='bonferroni'),ncol=ncol(matrix_pvalue))
  matrix_pvalue = formatC(matrix_pvalue, format = "e", digits = 2)
  
  # png(paste0(work_dir, "LinearReg_15pcs_covariates.png"), width = 10, height = 10, res = 600, units = "in")
  # pdf(paste0(work_dir, "LinearReg_15pcs_covariates.pdf"), width = 10, height = 10)
  
  hh<-Heatmap(matrix_rsquared, 
              column_title = heatmap_title, 
              cluster_rows = T,
              cluster_columns = F,
              show_row_dend = T,
              show_column_dend = F,
              show_row_names = T,
              show_column_names = T,
              name = 'R squared',
              clustering_method_rows = "ward.D2",
              clustering_distance_rows = "euclidean",
              col = colorRampPalette(RColorBrewer::brewer.pal(6,"GnBu"))(30), 
              column_names_gp = grid::gpar(fontsize = fs1),
              row_names_gp = grid::gpar(fontsize = fs1))
  #cell_fun = function(j, i, x, y, width, height, fill) {
  #grid.text(matrix_pvalue[i,j], x, y, gp = gpar(fontsize = fs2))}
  if (print){
    draw(hh)
  }
  
  #return pcs
  if (return.PC){
    highest_PC <- which.max(abs(matrix_rsquared[rownames(matrix_rsquared) %in% 'Diagnosis',]))
    eigengene <- pca.cov$rotation[,highest_PC] 
    #rotations are the loadings - the eigenvectors of, in this case, the donors
    # should not do $x, because that is the coordinate for PC# vs PC# plot 
    meta_in<-cov.df%>%dplyr::filter(grepl("Control|PD",Diagnosis))
    meta_in$Eigengene<-eigengene
    meta_in
  }
  
  #plot boxplot
  if (boxplot){
   
    bp1 <- eigen_plot(meta_in, meta_in$Diagnosis,meta_in$Eigengene, y_title=paste0('PC',highest_PC),plot_title=title_box)
    plot(bp1)
  }
}
